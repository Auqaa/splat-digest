# Обязательные
LLM_API_KEY=sk-...                 # ключ DeepSeek (platform.deepseek.com); DEEPSEEK_API_KEY тоже принимается
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# LLM
# LLM_PROVIDER=deepseek                        # deepseek | kimi — задаёт base_url и модель по умолчанию
# LLM_MODEL=deepseek-flash                     # deepseek-v4-pro — в ~4 раза дороже, для оценки аннотаций не нужен
# LLM_BASE_URL=https://api.deepseek.com
# LLM_THINKING=disabled                        # disabled | omit
# LLM_MAX_TOKENS=1500

# Второй проход: модель читает полный текст самых релевантных статей (deepseek_read_url, только DeepSeek)
# DEEP_READ=1
# DEEP_READ_MIN=7                              # с какой оценки по аннотации читать полный текст
# DEEP_READ_MAX=5                              # не больше N статей за запуск

# Необязательные ключи источников
# GITHUB_TOKEN=            # без него поиск GitHub — 10 запросов/мин; в Actions подставляется сам
# S2_API_KEY=              # Semantic Scholar: без ключа часто 429
# BLUESKY_HANDLE=you.bsky.social
# BLUESKY_APP_PASSWORD=    # Settings → App passwords (не основной пароль!)

# Поведение
# SOURCES=arxiv,hf_daily,hn,s2,openreview,github_releases,github_repos,awesome,hf_hub,reddit,bluesky,vendors
# SOURCES_FILE=sources.toml
# LOOKBACK_DAYS=3
# MIN_RELEVANCE=5
# MAX_ITEMS_LLM=150
# LLM_CONCURRENCY=4
# STATE_PATH=data/state.db
# SEND_EMPTY_DIGEST=1
