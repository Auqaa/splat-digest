# Обязательные
LLM_API_KEY=sk-...                 # ключ Kimi: platform.moonshot.ai → API Keys
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# LLM (любой OpenAI-совместимый API; по умолчанию Kimi)
# LLM_BASE_URL=https://api.moonshot.ai/v1     # для Китая: https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k2.6                          # kimi-k3 / kimi-k3.1-pro — дороже, всегда «думают»
# LLM_THINKING=disabled                        # disabled | omit (для K3 ставится omit автоматически)
# LLM_MAX_TOKENS=1500                          # для K3 по умолчанию 8000 (рассуждения съедают токены)

# Необязательные ключи источников
# GITHUB_TOKEN=            # без него поиск GitHub — 10 запросов/мин; в Actions подставляется сам
# S2_API_KEY=              # Semantic Scholar: без ключа часто 429
# BLUESKY_HANDLE=you.bsky.social
# BLUESKY_APP_PASSWORD=    # Settings → App passwords (не основной пароль!)

# Поведение
# SOURCES=arxiv,hf_daily,hn,s2,openreview,github_releases,github_repos,awesome,hf_hub,reddit,bluesky,vendors
# SOURCES_FILE=sources.toml
# LOOKBACK_DAYS=3
# MIN_RELEVANCE=5
# MAX_ITEMS_LLM=150
# LLM_CONCURRENCY=4
# STATE_PATH=data/state.db
# SEND_EMPTY_DIGEST=1
